{
    "build": {
        "dockerfile": "../Dockerfile.dev",
        "context": ".."
    },
    "runArgs": [
        "--cap-add=SYS_ADMIN",
        "--cap-add=IPC_LOCK",
        "--security-opt=seccomp=unconfined"
    ],
    "remoteUser": "developer",
    "workspaceMount": "source=${localWorkspaceFolder},target=/matrix_service,type=bind",
    "workspaceFolder": "/matrix_service",
    "containerEnv": {
        "SHELL": "/bin/bash",
        "PREFIX": "/matrix_service/.local",
        "CCACHE_DIR": "/matrix_service/.ccache",
        "CORES_DIR": "/cores"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools",
                "ms-vscode.makefile-tools",
                "vadimcn.vscode-lldb"
            ],
            "settings": {
                "cmake.automaticReconfigure": false,
                "cmake.configureOnEdit": false,
                "cmake.configureOnOpen": false,
                "cmake.copyCompileCommands": "${workspaceFolder}/.vscode/compile_commands.json",
                "clangd.path": "/usr/bin/clangd",
                "clangd.arguments": [
                    "--background-index",
                    "--compile-commands-dir=.vscode",
                    "--clang-tidy",
                    "--completion-style=detailed",
                    "--header-insertion=never"
                ]
            }
        }
    },
    "onCreateCommand": "git config --global --add safe.directory /matrix_service"
}